# Copie para .env (ignorado pelo git). Nunca commite valores reais.

# Escolhe o caminho nativo (GitHub Copilot). Mantenha dry-run até o ensaio.
AGENT_RUNTIME=github-native
AGENT_DRY_RUN=true

# Repositório que recebe as issues e o token do BACKEND (só cria issue e lê comentários).
# Este token é diferente do secret COPILOT_AGENT_TOKEN, que fica só nas Actions.
GITHUB_REPO=dono/repositorio
GITHUB_ISSUES_TOKEN=
